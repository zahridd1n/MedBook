# =============================================================================
# BookFlow — Environment Configuration
# =============================================================================
# Local development: copy this file to .env and it just works with SQLite.
# Production server: uncomment DB_* lines and fill in PostgreSQL credentials.
# =============================================================================

DEBUG=True
# Generate a strong secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.bookflow.uz
PRIMARY_DOMAIN=bookflow.uz

# ─── PostgreSQL (uncomment on production server) ──────────────────────────────
# DB_NAME=bookflow
# DB_USER=bookflow_user
# DB_PASSWORD=secure_password
# DB_HOST=localhost
# DB_PORT=5432

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
SITE_URL=https://yourdomain.com

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
